# --- Backend
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Public API (read) - no auth in MVP
PUBLIC_BASE_URL=http://localhost:8000

# Protected ingestion token (future use)
INGEST_TOKEN=dev-ingest-token

# --- Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=floodmvp
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/floodmvp
