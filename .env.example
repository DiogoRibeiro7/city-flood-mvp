# --- Backend
# Local demo only: anonymous privileged operations are allowed in dev.
# For production set APP_ENV=prod and provide JWT_SECRET or ANALYTICS_API_KEY.
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Public API (read) - no auth in MVP
PUBLIC_BASE_URL=http://localhost:8000

# Ingestion is protected independently of analytics authentication.
INGEST_TOKEN=dev-ingest-token
# Leave both empty only for a local demo.
JWT_SECRET=
ANALYTICS_API_KEY=
ANALYTICS_VERSION=v1
ANALYTICS_WINDOW_DAYS=1
RAIN_EVENT_THRESHOLD_MMPH=5.0
RAIN_EVENT_MIN_DURATION_MINUTES=15
OVERFLOW_FILL_THRESHOLD=1.0
OVERFLOW_MIN_DURATION_MINUTES=10
RISK_FILL_WATCH=1.15
RISK_FILL_WARNING=1.4
TELEMETRY_GAP_GRANULARITY_MINUTES=5
TELEMETRY_GAP_WINDOW_DAYS=1
RATE_LIMIT_RPS=5.0
RATE_LIMIT_BURST=20
# Maximum number of per-client and per-tenant buckets held by each API worker.
RATE_LIMIT_BUCKET_CAPACITY=4096
TENANT_QUOTA_RPS=8.0
TENANT_QUOTA_BURST=40
REQUEST_MAX_BYTES=1000000
REQUEST_TIMEOUT_S=10

# --- Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=floodmvp
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/floodmvp
